msgid "Add a new task. One required positional: the task name.\n\n\b\nInteractive defaults: list inferred from active task; assignee = you.\nPass `--blocks this` / `--parent this` to link the new task to the\nactive one, or `--blocks <id>` / `--parent <id>` to link to a specific\ntask."
msgstr "Agrega una tarea nueva. Requiere un argumento posicional: el nombre de la tarea.\n\n\b\nValores interactivos predeterminados: la lista se infiere de la tarea activa; asignado = tú.\nPasa `--blocks this` / `--parent this` para vincular la tarea nueva con la\ntarea activa, o `--blocks <id>` / `--parent <id>` para vincularla a una tarea\nespecífica."

msgid "Add a quick note (comment) to a task.\n\nTwo forms:\n\n\b\n  cupt note <task_id> <note_text>   # explicit\n  cupt note <note_text>             # uses active task (interactive only)"
msgstr "Agrega una nota rápida (comentario) a una tarea.\n\nDos formas:\n\n\b\n  cupt note <task_id> <note_text>   # explícito\n  cupt note <note_text>             # usa la tarea activa (solo interactivo)"

msgid "Add a tag to a task"
msgstr "Agregar una etiqueta a una tarea"

msgid "Add manual time entry to a task.\n\nForms:\n\n\b\n  cupt time add <task_id> <duration>   # explicit\n  cupt time add <duration>             # uses active task (interactive)"
msgstr "Agrega una entrada manual de tiempo a una tarea.\n\nFormas:\n\n\b\n  cupt time add <task_id> <duration>   # explícito\n  cupt time add <duration>             # usa la tarea activa (interactivo)"

